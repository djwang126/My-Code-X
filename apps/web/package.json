{
  "name": "my-code-x-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b tsconfig.json",
    "bundle": "vite build",
    "build": "npm run typecheck && npm run bundle",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts"
  },
  "dependencies": {
    "@my-code-x/contracts": "file:../../packages/contracts",
    "@my-code-x/utils": "file:../../packages/utils",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.1.1"
  },
  "license": "AGPL-3.0-only"
}
