{
  "name": "@my-code-x/web-new",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pretypecheck": "npm run build --workspace @my-code-x/contracts-new",
    "typecheck": "tsc -b tsconfig.json",
    "pretest": "npm run build --workspace @my-code-x/contracts-new",
    "test": "tsx --test --test-reporter=dot src/**/*.test.ts",
    "build": "npm run typecheck && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts"
  },
  "dependencies": {
    "@my-code-x/contracts-new": "file:../contracts",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^7.3.2"
  },
  "license": "AGPL-3.0-only"
}
