{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.d.mts"
  ]
}
